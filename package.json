{
  "name": "ai-website-engineering-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Governed, cost-aware AI website engineering platform",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.13.0 <23",
    "npm": ">=10 <11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "turbo run typecheck",
    "test": "vitest run --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:browser": "tsx scripts/run-browser-tests.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "db:generate": "npm run db:generate --workspace @platform/database",
    "db:migrate": "npm run db:migrate --workspace @platform/database",
    "db:migrate:check": "npm run db:migrate:check --workspace @platform/database",
    "db:migrate:integration": "npm run db:migrate:integration --workspace @platform/database",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "security:deps": "npm audit --audit-level=high",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run test:contract && npm run test:integration && npm run db:migrate:check && npm run build && npm run test:browser && npm run security:secrets && npm run security:deps"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "prettier": "3.9.6",
    "tsup": "8.5.1",
    "tsx": "4.23.1",
    "turbo": "2.10.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
