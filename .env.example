# Development-only, non-secret defaults. Copy to .env.local and replace values locally.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=4001
WORKER_ID=worker-local
LOG_LEVEL=info

# Development header auth is rejected when NODE_ENV=production.
AUTH_MODE=development
ALLOW_UNSAFE_LOCAL_AUTH_REMOTE=false
AUTH_ISSUER=https://identity.example.invalid/
AUTH_AUDIENCE=ai-website-engineering-platform
AUTH_JWKS_URI=https://identity.example.invalid/.well-known/jwks.json

# Local example only. Production credentials belong in an approved secrets manager.
DATABASE_URL=postgresql://platform:platform@127.0.0.1:5432/platform_local
DATABASE_REQUIRED=false

# Next.js loads app-scoped env files from apps/web/.env.local when web public
# runtime configuration is introduced. The M01 web surface does not require one.
